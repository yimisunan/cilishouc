# Publish only the maintained Android application and its documentation.
/*
!/.gitignore
!/README.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/android-release.yml
!/AndroidApp/
/AndroidApp/*
!/AndroidApp/AndroidManifest.xml
!/AndroidApp/README.md
!/AndroidApp/build.sh
!/AndroidApp/version.properties
!/AndroidApp/src/
!/AndroidApp/src/**
!/AndroidApp/res/
!/AndroidApp/res/**

# Keep local state, tests and generated output out of production sources.
.operit/
.nomedia
qa/
test/
tests/
androidTest/
node_modules/
build/
dist/
target/
.gradle/
.dart_tool/
__pycache__/
.cache/
.venv/
coverage/
*.class
*.dex
*.apk
*.apk.idsig
*.log
*.tmp
*.bak

# Signing keys, credentials and private application data stay local.
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
.env
.env.*
local.properties
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.mjbf