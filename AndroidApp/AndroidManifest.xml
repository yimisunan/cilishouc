<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.magnetvault.app">

    <!-- 仅坚果云备份需要联网；其余功能完全离线 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 每日自动备份任务要求"有网络才执行"，系统要求这个权限才能带网络约束 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 每日自动备份任务需要在重启后继续生效 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <package android:name="com.moecloud.helper" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="magnet" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="ed2k" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity android:name=".ImportActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SearchActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity android:name=".EditActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".DetailActivity" android:exported="false" />
        <activity android:name=".CategoryActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".TrashActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".DavActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CloudActivity" android:exported="false" />

        <service
            android:name=".BackupJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 外部一键添加：浏览器脚本 magnetvault://add?... / magnetvault://import-clipboard -->
        <activity
            android:name=".QuickAddActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnetvault" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>