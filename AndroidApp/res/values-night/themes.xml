<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/c_bg</item>
        <item name="android:colorAccent">@color/c_accent</item>
        <item name="android:colorControlNormal">@color/c_text2</item>
        <item name="android:textColorPrimary">@color/c_text</item>
        <item name="android:textColorSecondary">@color/c_text2</item>
        <item name="android:textColorHint">@color/c_text2</item>
        <item name="android:statusBarColor">@color/c_bg</item>
        <item name="android:navigationBarColor">@color/c_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorButtonNormal">@color/c_card2</item>
    </style>

    <style name="AppTheme.Light" parent="AppTheme" />
    <style name="AppTheme.Dark" parent="AppTheme" />

    <style name="SheetAnim">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <style name="SheetDialog" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.60</item>
        <item name="android:windowAnimationStyle">@style/SheetAnim</item>
        <item name="android:textColorPrimary">@color/c_text</item>
        <item name="android:colorAccent">@color/c_accent</item>
    </style>
</resources>