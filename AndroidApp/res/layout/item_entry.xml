<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:descendantFocusability="blocksDescendants">

    <LinearLayout
        android:id="@+id/entry_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="4dp"
        android:paddingBottom="12dp"
        android:background="@drawable/bg_card">

        <View
            android:id="@+id/dot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/item_badge"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="top"
            android:layout_marginTop="2dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/bg_badge_magnet">

            <ImageView
                android:id="@+id/item_icon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_magnet"
                android:tint="@color/c_accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="false"
                android:scrollHorizontally="false"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="none"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/c_text"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/item_proto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/bg_badge_magnet"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="BT"
                    android:textColor="@color/c_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/item_sub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/c_text2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/item_star"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:focusable="false"
            android:padding="12dp"
            android:src="@drawable/ic_star_outline"
            android:tint="@color/c_text2" />

        <ImageView
            android:id="@+id/item_more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="更多操作"
            android:focusable="false"
            android:padding="12dp"
            android:src="@drawable/ic_more"
            android:tint="@color/c_text2" />
    </LinearLayout>
</LinearLayout>
