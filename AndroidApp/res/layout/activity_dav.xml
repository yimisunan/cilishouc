<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:tint="@color/c_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:text="坚果云连接"
            android:textColor="@color/c_header_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <TextView
                style="@style/FieldLabel"
                android:drawableLeft="@drawable/ic_link"
                android:drawablePadding="6dp"
                android:drawableTint="@color/c_accent"
                android:text="服务器地址"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_url"
                style="@style/FieldInput"
                android:hint="https://dav.jianguoyun.com/dav/"
                android:inputType="textUri" />

            <TextView
                style="@style/FieldLabel"
                android:drawableLeft="@drawable/ic_user"
                android:drawablePadding="6dp"
                android:drawableTint="@color/c_accent2"
                android:text="账号（邮箱）"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_user"
                style="@style/FieldInput"
                android:hint="you@example.com"
                android:inputType="textEmailAddress" />

            <TextView
                style="@style/FieldLabel"
                android:drawableLeft="@drawable/ic_lock"
                android:drawablePadding="6dp"
                android:drawableTint="@color/c_accent"
                android:text="应用密码（坚果云「安全选项 → 添加应用」生成）"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_pass"
                style="@style/FieldInput"
                android:hint="应用密码"
                android:inputType="textPassword" />

            <TextView
                style="@style/FieldLabel"
                android:drawableLeft="@drawable/ic_folder"
                android:drawablePadding="6dp"
                android:drawableTint="@color/c_accent2"
                android:text="备份目录（不存在会自动创建）"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_dir"
                style="@style/FieldInput"
                android:hint="磁力收藏夹"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btn_test"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="14dp"
                android:background="@drawable/bg_fab"
                android:drawableLeft="@drawable/ic_cloud"
                android:drawablePadding="8dp"
                android:drawableTint="@color/c_on_accent"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="保存并测试连接"
                android:textColor="@color/c_on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_result"
                style="@style/CardPanel"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/c_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="18dp"
                android:lineSpacingExtra="5dp"
                android:text="测试流程：① PROPFIND 根目录（验证账号密码）→ ② MKCOL 备份目录（不存在则创建）→ ③ 上传 32 字节探测文件 → ④ PROPFIND 校验大小 → ⑤ 删除探测文件。"
                android:textColor="@color/c_text2"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>