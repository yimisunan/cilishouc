<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/c_bg" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_header" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_back" android:tint="@color/c_header_text" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="返回" android:minHeight="48dp" android:focusable="true" />
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_cloud" android:tint="@color/c_accent" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:layout_weight="1" android:letterSpacing="0" android:text="坚果云连接" android:textColor="@color/c_header_text" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="26dp">
            <TextView style="@style/FieldLabel" android:drawableLeft="@drawable/ic_link" android:drawablePadding="6dp" android:drawableTint="@color/c_accent" android:text="服务器地址" />
            <EditText android:id="@+id/input_url" style="@style/FieldInput" android:hint="https://dav.jianguoyun.com/dav/" android:inputType="textUri" />
            <TextView style="@style/FieldLabel" android:drawableLeft="@drawable/ic_cat" android:drawablePadding="6dp" android:drawableTint="@color/c_accent2" android:text="账号（邮箱）" />
            <EditText android:id="@+id/input_user" style="@style/FieldInput" android:hint="you@example.com" android:inputType="textEmailAddress" />
            <TextView style="@style/FieldLabel" android:drawableLeft="@drawable/ic_lock" android:drawablePadding="6dp" android:drawableTint="@color/c_accent" android:text="应用密码（坚果云「安全选项 → 添加应用」生成，不是登录密码）" />
            <EditText android:id="@+id/input_pass" style="@style/FieldInput" android:hint="应用密码" android:inputType="textPassword" />
            <TextView style="@style/FieldLabel" android:drawableLeft="@drawable/ic_folder" android:drawablePadding="6dp" android:drawableTint="@color/c_accent2" android:text="备份目录（不存在会自动创建）" />
            <EditText android:id="@+id/input_dir" style="@style/FieldInput" android:hint="磁力收藏夹" android:inputType="text" android:maxLines="1" />
            <TextView android:id="@+id/btn_test" style="@style/PrimaryButton" android:layout_marginTop="22dp" android:drawableLeft="@drawable/ic_cloud" android:drawablePadding="8dp" android:drawableTint="@color/c_accent" android:text="保存并测试连接" android:minHeight="48dp" android:focusable="true" />
            <TextView android:id="@+id/tv_result" style="@style/CardPanel" android:layout_marginTop="16dp" android:lineSpacingExtra="5dp" android:textColor="@color/c_text" android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="18dp" android:layout_marginRight="18dp" android:layout_marginTop="16dp" android:lineSpacingExtra="5dp" android:textColor="@color/c_text2" android:textSize="13sp" android:text="测试流程：① PROPFIND 根目录（验证账号密码）→ ② MKCOL 备份目录（不存在则创建）→ ③ 上传一个 32 字节探测文件 → ④ PROPFIND 校验大小 → ⑤ 删除探测文件。全部通过才算可用。" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>