<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部：猫头 + 标题 + 统计 + 搜索 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="6dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_cat"
                    android:tint="@color/c_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/app_name"
                        android:textColor="@color/c_header_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="共 0 条收藏"
                        android:textColor="@color/c_header_sub"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_menu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="11dp"
                    android:src="@drawable/ic_more"
                    android:tint="@color/c_header_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/c_text2" />

                <EditText
                    android:id="@+id/search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:textColor="@color/c_text"
                    android:textColorHint="@color/c_text2"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:drawablePadding="16dp"
                android:drawableTop="@drawable/ic_cat_silhouette"
                android:gravity="center"
                android:lineSpacingExtra="8dp"
                android:text="@string/empty_hint"
                android:textColor="@color/c_text2"
                android:textSize="13sp"
                android:visibility="gone" />

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@null"
                android:paddingTop="4dp"
                android:paddingBottom="100dp"
                android:scrollbars="none" />
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/fab"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="@drawable/bg_fab"
        android:elevation="10dp"
        android:padding="15dp"
        android:src="@drawable/ic_add"
        android:tint="#FF0B0F14" />

    <!-- 多选操作条 -->
    <LinearLayout
        android:id="@+id/batch_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_batch"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/batch_all"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:drawablePadding="2dp"
            android:drawableTint="@color/c_accent"
            android:drawableTop="@drawable/ic_check"
            android:gravity="center"
            android:text="全选"
            android:textColor="@color/c_header_text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/batch_move"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:drawablePadding="2dp"
            android:drawableTint="@color/c_header_text"
            android:drawableTop="@drawable/ic_folder"
            android:gravity="center"
            android:text="移出到"
            android:textColor="@color/c_header_text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/batch_tag"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:drawablePadding="2dp"
            android:drawableTint="@color/c_header_text"
            android:drawableTop="@drawable/ic_tag"
            android:gravity="center"
            android:text="标签"
            android:textColor="@color/c_header_text"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/batch_delete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:drawablePadding="2dp"
            android:drawableTint="@color/c_danger"
            android:drawableTop="@drawable/ic_trash"
            android:gravity="center"
            android:text="删除"
            android:textColor="@color/c_danger"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/batch_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:drawablePadding="2dp"
            android:drawableTint="@color/c_text2"
            android:drawableTop="@drawable/ic_close"
            android:gravity="center"
            android:text="取消"
            android:textColor="@color/c_text2"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>