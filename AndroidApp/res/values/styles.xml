<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 分区小标题：图标 + 文字 -->
    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">18dp</item>
        <item name="android:layout_marginRight">18dp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/c_text2</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 可点击行：卡片 + 左侧图标 -->
    <style name="CardRow">
        <item name="android:minHeight">56dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">14dp</item>
        <item name="android:layout_marginRight">14dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:textColor">@color/c_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 只读信息块：卡片 -->
    <style name="CardPanel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">14dp</item>
        <item name="android:layout_marginRight">14dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- 表单字段标题 -->
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">18dp</item>
        <item name="android:layout_marginRight">18dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/c_text2</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 输入框：焦点高亮边 -->
    <style name="FieldInput">
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">14dp</item>
        <item name="android:layout_marginRight">14dp</item>
        <item name="android:background">@drawable/bg_input_box</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/c_text</item>
        <item name="android:textColorHint">@color/c_text2</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 主按钮 -->
    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginLeft">14dp</item>
        <item name="android:layout_marginRight">14dp</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/c_accent</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>